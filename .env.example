# Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — server-side only, never exposed to the client.
# Used by API routes so booking writes aren't subject to client-side RLS edge cases
# during the assessment window. Keep this out of git; only .env.example is committed.
SUPABASE_SERVICE_ROLE_KEY=
